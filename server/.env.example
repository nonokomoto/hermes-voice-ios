# Goes in the Hermes profile's .env (e.g. ~/.hermes/profiles/pessoal/.env)
API_SERVER_ENABLED=true
API_SERVER_KEY=change-me          # the key you paste into the app's Settings
GEMINI_API_KEY=                   # Gemini TTS; without it the service falls back to Edge TTS

# Not read from this file: set these in the systemd unit (voz.py) and the watcher's cron environment
APNS_TOPIC=com.example.hermesvoice   # your app's bundle ID
CONDUCTOR=                           # agent-deck session id the watcher should follow
